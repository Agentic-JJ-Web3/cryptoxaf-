// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Chain {
  TRON
  BSC
}

enum OrderStatus {
  QUOTED
  AWAITING_PAYMENT
  PAYMENT_CLAIMED
  PAYMENT_VERIFIED
  COMPLETED
  EXPIRED
  REFUND_DUE
  REFUNDED
}

enum ActorType {
  SYSTEM
  CUSTOMER
  OPERATOR
}

enum MomoNetwork {
  MTN
  ORANGE
}

// Captures the live pricing inputs behind a single quote so a quoted rate
// can always be reconstructed and audited after the market has moved on.
model RateSnapshot {
  id               String   @id @default(uuid())
  chain            Chain
  // XAF per 1 USDT, scaled by 1e6, e.g. 650_500_000 == 650.5 XAF/USDT.
  marketRateMicros BigInt
  // Flat, per-order network fee in XAF at capture time (gas cost + buffer).
  networkFeeXaf    Int
  // Margin applied on top of market rate, in basis points (150 == 1.50%).
  targetMarginBps  Int
  // marketRateMicros * (1 + targetMarginBps / 10000), precomputed at capture time.
  quotedRateMicros BigInt
  capturedAt       DateTime @default(now())

  order            Order?

  @@index([capturedAt])
}

// The swap order. `status` only moves along the legal edges of the state
// machine and can never leave a terminal state — both enforced by a
// trigger installed in the migration, not by application code alone.
model Order {
  id                 String      @id @default(uuid())
  // Bearer token for order lookup; never log unmasked (see CLAUDE.md Security).
  reference          String      @unique
  status             OrderStatus @default(QUOTED)
  chain              Chain

  destinationAddress String

  // What the customer types and what leaves their MoMo. No minor unit in XAF.
  xafAmount          Int
  // Base units for `chain`'s USDT contract (6dp Tron, 18dp BSC) — see
  // src/config/chains.js. NUMERIC(38,0), not BIGINT: 18dp BSC amounts
  // overflow int8 past ~9.2 USDT. Exact integer column, no float, wide
  // enough — src/db/money.js converts to/from a native BigInt at the
  // service boundary so the rest of the app never touches Decimal.
  usdtAmount         Decimal      @db.Decimal(38, 0)

  rateSnapshotId     String       @unique
  rateSnapshot       RateSnapshot @relation(fields: [rateSnapshotId], references: [id])

  quoteExpiresAt     DateTime

  // Customer-submitted MoMo transaction id (PAYMENT_CLAIMED).
  paymentReference   String?
  // Customer's MoMo number, submitted alongside paymentReference so the
  // operator can cross-check it in their own MoMo app. Never log unmasked.
  customerMomoNumber String?
  // On-chain payout hash, recorded together with the COMPLETED transition.
  payoutTxHash       String?      @unique
  // Why an order was sent to REFUND_DUE.
  refundReason       String?

  auditLogs          OrderAuditLog[]

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([status])
}

// Append-only history of every status transition. UPDATE and DELETE are
// blocked by trigger at the database level.
model OrderAuditLog {
  id         String       @id @default(uuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id])
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorType  ActorType
  // e.g. "system", "customer", "operator:<operatorId>" — never a bare MoMo number.
  actor      String
  note       String?
  createdAt  DateTime     @default(now())

  @@index([orderId])
  @@index([createdAt])
}

// An admin user. Provisioned out-of-band (seed script / direct DB access
// for now, an admin-settings screen later) — there is no signup route,
// mirroring the customer side's "no accounts" ethos for a different reason:
// operators are trusted staff, not self-service signups.
model Operator {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([email])
}

// Single-row table (id is always "default") holding the operator-configured
// inputs the pricing engine reads. This is the manual `RateProvider` — the
// same "manual implementation only, for now" pattern as PaymentCollector
// and PayoutExecutor. Live feeds (Binance P2P, gas oracles) come later and
// slot in behind the same read shape without changing callers.
model PlatformSettings {
  id                String      @id @default("default")
  // XAF per 1 USDT, scaled by 1e6 — same representation as RateSnapshot.
  xafUsdtRateMicros BigInt
  tronNetworkFeeXaf Int
  bscNetworkFeeXaf  Int
  // Basis points (150 == 1.50%), clamped at read time to sane bounds
  // regardless of what's stored here — see src/pricing/rateProvider.js.
  targetMarginBps   Int
  // How long this row may be trusted before quoting refuses to proceed.
  // Generous by default because a human, not a live feed, updates this.
  rateTtlSeconds    Int         @default(86400)
  momoNetwork       MomoNetwork
  momoNumber        String
  updatedAt         DateTime    @updatedAt
  updatedBy         String?
}

// Append-only security/audit trail for admin actions that aren't order
// state transitions (those live in OrderAuditLog instead, keyed off
// fromStatus/toStatus). Currently just login attempts; the natural home
// for admin-settings changes once that screen exists. UPDATE and DELETE
// are blocked by trigger, same as OrderAuditLog.
model AdminAuditLog {
  id        String   @id @default(uuid())
  // "operator:<operatorId>" on success, "unknown:<email>" on a failed
  // login where we can't yet attribute the attempt to a real operator.
  actor     String
  action    String
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
