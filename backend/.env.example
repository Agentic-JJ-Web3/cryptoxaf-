DATABASE_URL="postgresql://user:password@localhost:5432/cryptoxaf"
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/cryptoxaf_test"

NODE_ENV=development
PORT=3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Comma-separated origins allowed to call this API with credentials. Unset
# in dev reflects any origin (fine locally); set explicitly in production.
CORS_ORIGIN=http://localhost:5173

# Read-only RPC endpoints used for address/contract validation. Public
# defaults work but are rate-limited — swap in a dedicated provider
# (Alchemy/QuickNode/TronGrid API key) before relying on this in production.
TRON_RPC_URL=https://api.trongrid.io
BSC_RPC_URL=https://bsc-dataseed.binance.org

# Dev-only: seeds one operator via `npm run seed`. Not a real provisioning
# path — see prisma/seed.js.
OPERATOR_SEED_EMAIL=
OPERATOR_SEED_PASSWORD=
OPERATOR_SEED_NAME=

# Dev-only: seeds the manual RateProvider's single settings row via
# `npm run seed`. A real operator adjusts this through admin settings later.
SEED_XAF_USDT_RATE=
SEED_TRON_NETWORK_FEE_XAF=
SEED_BSC_NETWORK_FEE_XAF=
SEED_TARGET_MARGIN_BPS=
SEED_MOMO_NETWORK=
SEED_MOMO_NUMBER=
SEED_MOMO_ACCOUNT_NAME=
